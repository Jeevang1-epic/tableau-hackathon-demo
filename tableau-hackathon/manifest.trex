<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.hackathon.actionable" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Hackathon Action Extension</description>
    <author name="Puttala Jeevan Kumar" email="ipad11169@gmail.com" organization="Hackathon Team" website="https://github.com/jeevang1-epic"/>
    <min-api-version>1.0</min-api-version>
   <source-location>
      <url>https://jeevang1-epic.github.io/tableau-hackathon-demo/tableau-hackathon/index.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Smart Action Center</text>
    </resource>
  </resources>
</manifest>