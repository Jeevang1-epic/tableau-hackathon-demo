<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.jeevan.smartaction" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Actionable Analytics Extension for Tableau Hackathon</description>
    <author name="Puttala Jeevan Kumar" email="ipad11169@gmail.com" organization="Independent Developer" website="https://github.com/Jeevang1-epic/tableau-hackathon-demo"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
     <url>https://jeevang1-epic.github.io/tableau-hackathon-demo/tableau-hackathon/index.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Smart Action Center Pro</text>
    </resource>
  </resources>
</manifest>

